{
  "openapi": "3.1.0",
  "info": {
    "title": "GS-One External Video API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key"
      },
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "GS-One Session Token"
      }
    }
  },
  "security": [
    {
      "BearerApiKey": []
    }
  ],
  "paths": {
    "/api/v1/videos/generate": {
      "post": {
        "summary": "Submit video generation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "episode_id": {
                    "type": "string"
                  },
                  "segment_id": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "integer"
                  },
                  "resolution": {
                    "type": "string"
                  },
                  "aspect_ratio": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "501": {
            "description": "Generation core not migrated/configured"
          }
        }
      }
    },
    "/api/v1/videos": {
      "get": {
        "summary": "List generations",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/videos/{id}": {
      "get": {
        "summary": "Get generation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/videos/{id}/cancel": {
      "post": {
        "summary": "Cancel generation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "summary": "List upstream AI models",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/wallet": {
      "get": {
        "summary": "Read upstream wallet",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/graphql": {
      "post": {
        "summary": "GraphQL endpoint",
        "responses": {
          "200": {
            "description": "GraphQL response"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a GS-One SaaS account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account and session created"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Sign in and receive a session token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "identifier",
                  "password"
                ],
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get the signed-in user",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke the current session",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/v1/api-keys": {
      "get": {
        "summary": "List API keys for the signed-in account",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "API key metadata"
          }
        }
      },
      "post": {
        "summary": "Create an API key for the signed-in account",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "API key created; secret returned once"
          }
        }
      },
      "delete": {
        "summary": "Revoke an API key",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API key revoked"
          }
        }
      }
    }
  }
}
