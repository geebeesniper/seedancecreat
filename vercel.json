{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": "/api-docs.html"
    },
    {
      "source": "/health/runtime",
      "destination": "/api/health-runtime"
    },
    {
      "source": "/health/db",
      "destination": "/api/health-db"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/local-videos",
      "destination": "/local-videos.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/library",
      "destination": "/index.html"
    },
    {
      "source": "/pipeline",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
