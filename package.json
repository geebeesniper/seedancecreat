{
  "name": "gs-one-saas-typescript",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/localServer.ts",
    "start": "node dist/src/localServer.js",
    "build": "tsc -p tsconfig.json && node dist/src/scripts/dbCheck.js",
    "test": "tsx tests/smoke.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:check": "tsx src/scripts/dbCheck.ts",
    "api-key:help": "node -e \"console.log('Set API_ADMIN_SECRET, then POST /api/v1/api-keys with x-api-admin-secret')\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.5.0",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "fastify-raw-body": "^6.0.0",
    "stripe": "^22.4.0",
    "graphql": "^16.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
